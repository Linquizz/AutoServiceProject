<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:AutoService.Views"
             x:Class="AutoService.Views.AdminView">
    <Grid RowDefinitions="Auto,*,Auto">
        <TextBlock Text="Администрирование" Classes="h1" />
        <views:EmployeesView Grid.Row="1" DataContext="{Binding Employees}" />
        <views:BackupView Grid.Row="2" DataContext="{Binding Backup}" Margin="0,12,0,0" />
    </Grid>
</UserControl>
