<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:AutoService.Views"
             x:Class="AutoService.Views.ReferencesView">
    <Grid RowDefinitions="Auto,*">
        <TextBlock Text="Справочники" Classes="h1" />
        <TabControl Grid.Row="1">
            <TabItem Header="Марки и модели">
                <views:BrandsView DataContext="{Binding Brands}" />
            </TabItem>
            <TabItem Header="Услуги">
                <views:ServicesView DataContext="{Binding Services}" />
            </TabItem>
            <TabItem Header="Запасные части">
                <views:PartsView DataContext="{Binding Parts}" />
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
