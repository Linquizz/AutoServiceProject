<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AutoService.Views.AddWorkWindow"
        Title="{Binding Title}"
        Width="780" Height="600" MinWidth="620" MinHeight="480"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20" RowDefinitions="Auto,Auto,*,Auto,Auto">
        <TextBlock Text="{Binding Title}" Classes="h1" />

        <WrapPanel Grid.Row="1" Classes="row" IsVisible="{Binding CanPickService}" Margin="0,0,0,4">
            <TextBlock Text="Поиск услуги:" VerticalAlignment="Center" />
            <TextBox Width="320" Text="{Binding SearchText}" />
        </WrapPanel>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Services}" SelectedItem="{Binding SelectedService}"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  IsEnabled="{Binding CanPickService}"
                  GridLinesVisibility="All" BorderThickness="1" BorderBrush="{DynamicResource GridBorderBrush}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Услуга" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Стоимость, руб." Binding="{Binding Price, StringFormat='{}{0:N2}'}" Width="140" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Classes="card" Margin="0,12,0,0">
            <Grid ColumnDefinitions="2*,*,*">
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Исполнитель *" Classes="label" Margin="0,0,0,3" />
                    <ComboBox ItemsSource="{Binding Employees}" SelectedItem="{Binding SelectedEmployee}" HorizontalAlignment="Stretch" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="Продолжительность, ч" Classes="label" Margin="0,0,0,3" />
                    <TextBox Text="{Binding DurationText}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Стоимость, руб." Classes="label" Margin="0,0,0,3" />
                    <TextBox Text="{Binding PriceText}" IsReadOnly="True" />
                </StackPanel>
            </Grid>
        </Border>

        <DockPanel Grid.Row="4" Margin="0,12,0,0">
            <WrapPanel DockPanel.Dock="Right" Classes="row">
                <Button Content="{Binding ConfirmText}" Classes="primary" Command="{Binding ConfirmCommand}" IsDefault="True" />
                <Button Content="Отмена" Command="{Binding CancelCommand}" IsCancel="True" />
            </WrapPanel>
            <TextBlock Text="{Binding ErrorMessage}" Classes="error" IsVisible="{Binding HasError}" Margin="0,0,12,0" VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</Window>
