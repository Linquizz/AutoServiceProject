<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AutoService.Views.ReportsView">
    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
        <TextBlock Text="Отчёты" Classes="h1" />

        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="Период с:" VerticalAlignment="Center" Margin="0,0,6,6" />
            <CalendarDatePicker SelectedDate="{Binding DateFrom}" Margin="0,0,8,6" />
            <TextBlock Text="по:" VerticalAlignment="Center" Margin="0,0,6,6" />
            <CalendarDatePicker SelectedDate="{Binding DateTo}" Margin="0,0,12,6" />
            <TextBox Width="240" Text="{Binding SearchText}" Margin="0,0,8,6">
                <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
                </TextBox.KeyBindings>
            </TextBox>
            <Button Content="Сформировать список" Classes="primary" Command="{Binding SearchCommand}" Margin="0,0,8,6" />
            <Button Content="Сбросить" Command="{Binding ResetCommand}" Margin="0,0,8,6" />
        </WrapPanel>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder}"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  GridLinesVisibility="All" BorderThickness="1" BorderBrush="{DynamicResource GridBorderBrush}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="70" />
                <DataGridTextColumn Header="Начало" Binding="{Binding StartDate, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" Width="140" />
                <DataGridTextColumn Header="Окончание" Binding="{Binding EndDate, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" Width="140" />
                <DataGridTextColumn Header="Клиент" Binding="{Binding ClientName}" Width="1.4*" />
                <DataGridTextColumn Header="Автомобиль" Binding="{Binding CarTitle}" Width="*" />
                <DataGridTextColumn Header="Госномер" Binding="{Binding RegistrationNumber}" Width="110" />
                <DataGridTextColumn Header="E-mail клиента" Binding="{Binding Car.Client.Email}" Width="1.2*" />
                <DataGridTextColumn Header="Сумма, руб." Binding="{Binding Total, StringFormat='{}{0:N2}'}" Width="120" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" Text="{Binding Summary}" Classes="hint" Margin="0,8,0,0" />

        <Border Grid.Row="4" Classes="card" Margin="0,10,0,0">
            <StackPanel Spacing="8">
                <TextBlock Text="PDF выбранного заказ-наряда" FontWeight="SemiBold" />
                <WrapPanel Classes="row">
                    <TextBlock Text="Отправить на e-mail:" VerticalAlignment="Center" />
                    <TextBox Width="320" Text="{Binding RecipientEmail}" />
                    <Button Content="Отправить клиенту" Classes="primary" Command="{Binding SendCommand}"
                            IsEnabled="{Binding SelectedOrder, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <TextBlock Text="(адрес берётся из карточки клиента; перед отправкой его можно изменить)" Classes="hint" VerticalAlignment="Center" />
                </WrapPanel>
                <WrapPanel Classes="row">
                    <Button Content="Сформировать и открыть PDF" Command="{Binding CreatePdfCommand}"
                            IsEnabled="{Binding SelectedOrder, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <Button Content="Сохранить как..." Command="{Binding SaveAsCommand}"
                            IsEnabled="{Binding SelectedOrder, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <Button Content="Открыть папку с PDF" Command="{Binding OpenFolderCommand}" />
                </WrapPanel>
                <TextBlock Text="{Binding StatusMessage}" Classes="hint" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
