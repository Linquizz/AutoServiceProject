<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AutoService.Views.MainWindow"
        Title="Автосервис"
        Width="1280" Height="780" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <Grid ColumnDefinitions="220,*">

        <Border Background="{DynamicResource NavBackgroundBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="16" Spacing="2">
                    <TextBlock Text="{Binding UserName}" Foreground="White" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding UserRole}" Foreground="#9CA3AF" Margin="0,0,0,10" />
                    <Button Content="Светлая / тёмная тема" Command="{Binding ToggleThemeCommand}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,0,6" />
                    <Button Content="Выйти" Command="{Binding LogoutCommand}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                </StackPanel>

                <TextBlock DockPanel.Dock="Top" Text="АВТОСЕРВИС" Foreground="White"
                           FontSize="18" FontWeight="Bold" Margin="18,22,18,18" />

                <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                         Background="Transparent" Margin="8,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}" Foreground="White" FontSize="14" Margin="6,6" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Background="{DynamicResource AppBackgroundBrush}" Padding="16">
            <ContentControl Content="{Binding CurrentPage}" />
        </Border>
    </Grid>
</Window>
